# ---------------------------------------------------------------------------
# Mobile app (bundled into the client — PUBLIC values only)
# ---------------------------------------------------------------------------
# `supabase start` prints these for local development.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_APP_ENV=development

# RevenueCat public SDK keys (safe to ship; not secrets)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry DSN (public by design)
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Server-only (Edge Function secrets — NEVER prefix these with EXPO_PUBLIC_)
# Set with: supabase secrets set --env-file supabase/.env
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
OPENAI_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
