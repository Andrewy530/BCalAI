# ---------------------------------------------------------------------------
# Mobile app (bundled into the client — PUBLIC values only)
# ---------------------------------------------------------------------------
# `supabase start` prints these for local development.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_APP_ENV=development

# RevenueCat public SDK keys (safe to ship; not secrets)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry DSN (public by design)
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Server-only (Edge Function secrets — NEVER prefix these with EXPO_PUBLIC_)
# Set with: supabase secrets set --env-file supabase/.env
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the Google Cloud console entry exactly. Defaults to the callback
# function on SUPABASE_URL, which is right for hosted projects.
GOOGLE_OAUTH_REDIRECT_URI=
# Where the callback bounces the browser back into the app.
APP_OAUTH_RETURN_URL=calendarapp://settings/integrations
# Google requires an HTTPS endpoint for push notifications, so local webhook
# testing needs a tunnel. Leave unset to use SUPABASE_URL.
GOOGLE_WEBHOOK_URL=
# Shared secret pg_cron presents to sync-cron. Generate with `openssl rand -hex 32`.
# Without it the scheduled sync endpoint refuses every request.
SYNC_CRON_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
OPENAI_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
